{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>nklmilojevic/renovate-config", "helpers:pinGitHubActionDigests"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "separateMinorPatch": false
    },
    {
      "matchManagers": ["nix"],
      "groupName": "nix dependencies",
      "separateMinorPatch": false
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools",
      "separateMinorPatch": false
    },
    {
      "description": "image.yaml pushes the bastion image to GHCR with packages: write: Action updates are reviewed, never merged automatically.",
      "matchFileNames": [".github/workflows/**"],
      "automerge": false
    }
  ]
}
